# KaraFooki Environment Variables
#
# Copy this file to .env.local and fill in your values.
# The YouTube API key is OPTIONAL — you can always paste YouTube URLs directly.
# Without a key, search-by-name won't work.

# Get a free YouTube Data API v3 key at:
# https://console.cloud.google.com → APIs & Services → Enable "YouTube Data API v3"
VITE_YOUTUBE_API_KEY=
